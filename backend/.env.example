# Copy to backend/.env and fill in real values. Never commit backend/.env.

# MongoDB connection
MONGO_URL=mongodb://localhost:27017
DB_NAME=leadpulse

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Auth
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-64-char-hex-secret
TOKEN_EXPIRE_HOURS=24

# First-run bootstrap: creates one admin user if the users collection is empty.
# Safe to remove from .env after the first successful login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-run
