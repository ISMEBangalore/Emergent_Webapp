# Copy to backend/.env and fill in real values. Never commit backend/.env.

# MongoDB connection
MONGO_URL=mongodb://localhost:27017
DB_NAME=leadpulse

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Auth
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-64-char-hex-secret
TOKEN_EXPIRE_HOURS=24

# First-run bootstrap: creates one admin user if the users collection is empty.
# Safe to remove from .env after the first successful login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-run

# Proactive alert emails (Settings -> Proactive alert emails). Optional - if
# RESEND_API_KEY is unset, alert emails are skipped (logged only), everything
# else in the app works normally.
# RESEND_API_KEY=re_your_key_from_resend.com
# ALERT_EMAIL_FROM=LeadPulse Alerts <alerts@yourdomain.com>

# Shared secret an external cron (see render.yaml's isme-leadpulse-alert-check
# job) presents via the X-Cron-Secret header to trigger a scheduled alert
# check without a logged-in user's JWT. Leave unset to disable that endpoint.
# CRON_SECRET=generate-another-random-secret
